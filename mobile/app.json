{
  "expo": {
    "name": "OTP Bridge",
    "slug": "otp-bridge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/otpbridge2.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/otpbridge2.png"
    },
    "android": {
      "package": "com.otpbridge.app",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/otpbridge2.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/otpbridge2.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/otpbridge.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow OTP Bridge to access camera to scan pairing QR code."
        }
      ],
      "./plugins/withNotificationListener"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
