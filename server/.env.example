# OTP Bridge Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Security & Limits
MAX_PAYLOAD_SIZE_BYTES=16384
RATE_LIMIT_MAX=60
RATE_LIMIT_TIME_WINDOW_MS=60000

# TTL configurations (in seconds)
PAIRING_TOKEN_TTL_SECONDS=300
MESSAGE_QUEUE_TTL_SECONDS=300
MAX_QUEUED_MESSAGES_PER_RECEIVER=20

# Optional persistent storage path (leave empty for memory-only store)
DATA_FILE_PATH=
